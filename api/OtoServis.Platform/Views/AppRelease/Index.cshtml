@model AppReleaseForm
@{
    ViewData["Title"] = "Uygulama Sürümü";
}

@if (TempData["Flash"] is string flash)
{
    <div class="alert alert-success py-2">@flash</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h4 mb-1">Mobil uygulama sürümü</h1>
        <p class="text-muted small mb-4">
            Uygulama açılışında yüklü sürüm (Android version code) burada girilen
            <code>Minimum zorunlu version code</code>'un altındaysa kullanıcı Play Store'a
            yönlendiren, kapatılamayan bir "Güncelleme Gerekli" ekranı görür. Yüklü sürüm
            <code>Version code</code>'un altında ama minimumun üstündeyse, kapatılabilir bir
            "Yeni sürüm mevcut" uyarısı gösterilir.
        </p>

        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="LatestVersion" class="form-label"></label>
                    <input asp-for="LatestVersion" class="form-control" />
                    <span asp-validation-for="LatestVersion" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="LatestVersionCode" class="form-label"></label>
                    <input asp-for="LatestVersionCode" class="form-control" type="number" min="1" />
                    <span asp-validation-for="LatestVersionCode" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MinVersionCode" class="form-label"></label>
                    <input asp-for="MinVersionCode" class="form-control" type="number" min="1" />
                    <span asp-validation-for="MinVersionCode" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="ForceThisVersion" class="form-check-input" />
                        <label asp-for="ForceThisVersion" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="StoreUrl" class="form-label"></label>
                    <input asp-for="StoreUrl" class="form-control" placeholder="https://play.google.com/store/apps/details?id=com.efogy.mobilservisiniz" />
                    <span asp-validation-for="StoreUrl" class="text-danger small"></span>
                    <div class="form-text">"Güncelle" butonuna basıldığında açılacak Play Store sayfası.</div>
                </div>
                <div class="col-12">
                    <label asp-for="ReleaseNotes" class="form-label"></label>
                    <textarea asp-for="ReleaseNotes" class="form-control" rows="3"></textarea>
                </div>
            </div>

            @if (Model.UpdatedAt.HasValue)
            {
                <p class="text-muted small mt-3 mb-0">
                    Son güncelleme (UTC): @Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")
                </p>
            }

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-mobile-block">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@{
    var iosInfo = ViewBag.Ios as OtoServis.Platform.Services.IosOtaInfo;
}

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h5 mb-1">iOS IPA / plist dağıtım</h2>
        <p class="text-muted small mb-3">
            Ad Hoc veya Enterprise imzalı <code>.ipa</code> yükleyin. İsterseniz kendi
            <code>manifest.plist</code> dosyanızı da verin; vermezseniz sunucu üretir.
            Dosyalar API üzerinden şu adreste yayınlanır:
            <code>https://api.mobilservisiniz.com/apk/ios/mobilservisiniz/</code>
        </p>

        @if (TempData["IosFlash"] is string iosFlash)
        {
            <div class="alert alert-success py-2">@iosFlash</div>
        }
        @if (TempData["IosError"] is string iosError)
        {
            <div class="alert alert-danger py-2">@iosError</div>
        }

        @if (iosInfo?.InstallUrl is string installUrl)
        {
            <div class="border rounded-3 p-3 mb-3 bg-light">
                <div class="small text-muted mb-1">iPhone kurulum linki (Safari)</div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <code id="ios-install-url" class="flex-grow-1 text-break">@installUrl</code>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="navigator.clipboard.writeText(document.getElementById('ios-install-url').innerText)">Kopyala</button>
                    <a class="btn btn-sm btn-primary" href="@installUrl">Kurulumu aç</a>
                </div>
                <div class="small text-muted mt-2 mb-0">
                    IPA: <a href="@iosInfo.IpaUrl" target="_blank">@iosInfo.IpaUrl</a><br />
                    Plist: <a href="@iosInfo.PlistUrl" target="_blank">@iosInfo.PlistUrl</a>
                    @if (iosInfo.IpaUpdatedAt.HasValue)
                    {
                        <text> · Yüklendi: @iosInfo.IpaUpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</text>
                    }
                </div>
            </div>
        }
        else
        {
            <p class="text-muted small">Henüz IPA yüklenmedi.</p>
        }

        <form asp-action="UploadIos" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">iOS sürüm (bundle version)</label>
                    <input name="iosVersion" class="form-control" value="@Model.LatestVersion" placeholder="1.0.32" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">IPA dosyası</label>
                    <input type="file" name="ipaFile" class="form-control" accept=".ipa" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">manifest.plist (isteğe bağlı)</label>
                    <input type="file" name="plistFile" class="form-control" accept=".plist" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-outline-primary">IPA yayınla</button>
            </div>
        </form>
    </div>
</div>
